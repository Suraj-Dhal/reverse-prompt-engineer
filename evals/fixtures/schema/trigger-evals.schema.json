{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suraj-Dhal/reverse-prompt-engineer/evals/fixtures/schema/trigger-evals.schema.json",
  "title": "Reverse Prompt Engineer trigger fixtures",
  "description": "Requests that should, or should not, activate the reverse-prompt-engineer skill.",
  "type": "array",
  "minItems": 40,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "query", "expected_trigger", "tags", "fixture_type"],
    "properties": {
      "id": { "type": "string", "pattern": "^T[0-9]{2,3}$", "description": "Stable identifier, never reused." },
      "query": { "type": "string", "minLength": 1, "description": "The user message, phrased as a real user would type it." },
      "expected_trigger": { "type": "boolean", "description": "true if the skill should activate." },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "contains": { "const": "trigger" },
        "uniqueItems": true,
        "description": "Must include 'trigger'; 'positive'/'negative' and optional 'smoke'."
      },
      "notes": { "type": "string", "description": "Why the case exists (e.g. near-miss rationale)." },
      "fixture_type": { "const": "synthetic" }
    }
  }
}
